# Rust
/target/
**/target/
Cargo.lock.bak
.cargo-build-tmp/

# wasm-pack build output (regenerate with `wasm-pack build --target web --out-dir pkg`)
crdt-engine/pkg/
crdt-engine/pkg-node-verify/
relay-server/pkg/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
*.local

# frontend/src/wasm IS committed on purpose: it's the wasm-pack build output, checked
# in so `npm install && npm run dev` works with no Rust/wasm-pack toolchain required.
# Regenerate after changing crdt-engine with:
#   cd crdt-engine && wasm-pack build --target web --out-dir ../frontend/src/wasm

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Postgres local data (if run outside docker)
pgdata/
.pgtmp/
